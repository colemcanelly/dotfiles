#!/usr/bin/env sh

if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
  PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

export PATH="$PATH:/mnt/c/Windows\
:/mnt/c/Program Files (x86)/NVIDIA Corporation/PhysX/Common\
:/mnt/c/Program Files/NVIDIA Corporation/NVIDIA app/NvDLISR\
:/mnt/c/Program Files/Docker/Docker/resources/bin\
:/mnt/c/Users/ColeMcAnelly/AppData/Local/Programs/cursor/resources/app/bin\
:/mnt/c/Users/ColeMcAnelly/.local/bin\
:/mnt/c/Users/ColeMcAnelly/AppData/Local/Microsoft/WindowsApps\
:/mnt/c/Users/ColeMcAnelly/AppData/Local/Programs/Microsoft VS Code/bin\
:/mnt/c/Users/ColeMcAnelly/AppData/Local/Programs/cursor/resources/app/bin\
:/mnt/c/Users/ColeMcAnelly/AppData/Local/Microsoft/WinGet/Packages/NSSM.NSSM_Microsoft.Winget.Source_8wekyb3d8bbwe/nssm-2.24-101-g897c7ad/win64\
:/mnt/c/Users/ColeMcAnelly/AppData/Local/Programs/Zed/bin\
"

. "$HOME/.cargo/env"

export RIPGREP_CONFIG_PATH="$HOME/.config/rg/.ripgreprc"

export MANPAGER="bat -plman"
# export PSQL_PAGER='bat -plsql --paging=always --wrap=never'
export PSQL_PAGER='ov -d "|" -H1 --column-rainbow --align --column-mode --wrap=false'


# nvim
export NVIM_HOME="/home/cole/.local/share/bob/nvim-bin"
case ":$PATH:" in
  *":$NVIM_HOME:"*) ;;
  *) export PATH="$NVIM_HOME:$PATH" ;;
esac
# nvim end

# https://github.com/Schniz/fnm
eval "$(fnm env)"

# go binaries
export GOPATH="$(go env GOPATH)"
export PATH="$PATH:$GOPATH/bin"
export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"
