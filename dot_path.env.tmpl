#!/usr/bin/env sh

if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
  PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

{{ if dig "kernel" "osrelease" "" .chezmoi | lower | contains "microsoft" -}}
# WSL: Windows tools (only dirs that existed at `chezmoi apply` time)
{{-   $dirs := list
        "/mnt/c/Windows"
        "/mnt/c/Program Files (x86)/NVIDIA Corporation/PhysX/Common"
        "/mnt/c/Program Files/NVIDIA Corporation/NVIDIA app/NvDLISR"
        "/mnt/c/Program Files/Docker/Docker/resources/bin" -}}
{{-   range list
        ".local/bin"
        "AppData/Local/Microsoft/WindowsApps"
        "AppData/Local/Programs/cursor/resources/app/bin"
        "AppData/Local/Programs/Microsoft VS Code/bin"
        "AppData/Local/Programs/Zed/bin"
        "AppData/Local/Microsoft/WinGet/Packages/NSSM.NSSM_Microsoft.Winget.Source_8wekyb3d8bbwe/nssm-2.24-101-g897c7ad/win64" -}}
{{-     $dirs = append $dirs (printf "/mnt/c/Users/%s/%s" $.windowsUser .) -}}
{{-   end -}}
{{-   range $dirs }}{{ if stat . }}
export PATH="$PATH:{{ . }}"
{{- end }}{{ end }}
{{ end -}}

if [ -f "$HOME/.cargo/env" ]; then
  . "$HOME/.cargo/env"
fi

export RIPGREP_CONFIG_PATH="$HOME/.config/rg/.ripgreprc"

export MANPAGER="bat -plman"
# export PSQL_PAGER='bat -plsql --paging=always --wrap=never'
export PSQL_PAGER='ov -d "|" -H1 --column-rainbow --align --column-mode --wrap=false'


# nvim
export NVIM_HOME="$HOME/.local/share/bob/nvim-bin"
case ":$PATH:" in
  *":$NVIM_HOME:"*) ;;
  *) export PATH="$NVIM_HOME:$PATH" ;;
esac
# nvim end

# https://github.com/Schniz/fnm
if command -v fnm >/dev/null; then
  eval "$(fnm env)"
fi

# go binaries
if command -v go >/dev/null; then
  export GOPATH="$(go env GOPATH)"
  export PATH="$PATH:$GOPATH/bin"
fi
export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"
